[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Options.gd" id="1"]
[sub_resource type="StyleBoxFlat" id="Panel"]
bg_color = Color(0.04, 0.05, 0.07, 0.94)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_bottom_width = 1
